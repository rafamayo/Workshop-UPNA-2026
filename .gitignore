###############################################################################
# Instructor-only materials
###############################################################################
# This directory contains facilitator scripts, solution notes, assessment
# ideas, and teaching-only content. It should remain local.
instructor/

###############################################################################
# Python / Jupyter
###############################################################################
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*.so

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Virtual environments
venv/
.venv/
myvenv

# Jupyter related caches
.jupyter/
.jupyter_cache/

###############################################################################
# LaTeX / Beamer build artifacts
###############################################################################
*.aux
*.bbl
*.blg
*.brf
*.fls
*.fdb_latexmk
*.log
*.nav
*.out
*.snm
*.synctex.gz
*.toc
*.vrb
*.xdv
*.lof
*.lot

# Generated PDFs (optional: comment out if you want to track PDFs)
# *.pdf

# Generated images from TikZ / externalization
*.dpth
*.md5
*.auxlock

###############################################################################
# Node / Web development (if you add JS demos)
###############################################################################
node_modules/
dist/
build/
npm-debug.log
yarn-debug.log
yarn-error.log

###############################################################################
# OS-specific junk files
###############################################################################
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux temporary files
*~
*.swp
*.swo

###############################################################################
# Backup files
###############################################################################
*.bak
*.backup
*.tmp
*.temp

###############################################################################
# Misc
###############################################################################
# Ignore generated data or scratch directories
scratch/
tmp/
temp/
cache/
